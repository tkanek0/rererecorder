# Python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache

# Recorded sessions, exports and review movies. No trailing slash: data is
# usually a symbolic link to a disk with room, and git sees a link as a file.
/data

# Loose recording artefacts, in case anything is written outside data/
*.rsdb
*.db3
*.wav
*.jsonl

# Node (web frontend)
node_modules/
dist/
*.tsbuildinfo
